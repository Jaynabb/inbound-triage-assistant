# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Server-side only — this key is never exposed to the browser.
# The triage call happens in a Next.js route handler (app/api/triage/route.ts),
# so the key stays in the Node process.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5-20251001.
# Classification against a tight schema is what a small fast model is for;
# see RATIONALE.md for the Haiku-vs-Sonnet comparison.
TRIAGE_MODEL=claude-haiku-4-5-20251001
