# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Server-side only — this key is never exposed to the browser.
# The triage call happens in a Next.js route handler (app/api/triage/route.ts),
# so the key stays in the Node process.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5-20251001.
# Classification against a tight schema is what a small fast model is for;
# see RATIONALE.md for the Haiku-vs-Sonnet comparison.
TRIAGE_MODEL=claude-haiku-4-5-20251001

# Optional. Comma-separated message ids that should fail on a full run, so the
# unhappy path can be shown rather than described: TRIAGE_FAIL_IDS=inb-003
# makes that one message raise a 529 while the rest triage normally. It's
# ignored when retrying a single message, so the retry reaches the real API and
# succeeds. Unset in normal use — it can only cause a failure, never fake a
# success.
TRIAGE_FAIL_IDS=
